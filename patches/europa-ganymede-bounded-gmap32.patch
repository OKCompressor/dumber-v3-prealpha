+/// Return the nearest UTF-8 character boundary at or before `pos`.
+///
+/// The previous parallel implementation used `str::is_char_boundary()` over
+/// one whole-file String. This performs the same boundary decision without
+/// retaining the complete input in memory.
+fn utf8_boundary_at_or_before(
+    input_file: &str,
+    mut pos: u64,
+    len: u64,
+) -> Result<u64> {
+    use std::io::{Read, Seek, SeekFrom};
+
+    if pos == 0 || pos >= len {
+        return Ok(pos.min(len));
+    }
+
+    let mut f = fs::File::open(input_file)?;
+    let mut one = [0u8; 1];
+
+    loop {
+        f.seek(SeekFrom::Start(pos))?;
+        f.read_exact(&mut one)?;
+
+        // UTF-8 continuation bytes have the form 10xxxxxx.
+        if (one[0] & 0b1100_0000) != 0b1000_0000 {
+            return Ok(pos);
+        }
+
+        if pos == 0 {
+            return Ok(0);
+        }
+
+        pos -= 1;
+    }
+}
+
+/// Read exactly one scheduler range and validate it as UTF-8.
+///
+/// Memory is proportional to the active worker ranges instead of total input
+/// length.
+fn read_utf8_range(
+    input_file: &str,
+    start: u64,
+    end: u64,
+) -> Result<String> {
+    use std::io::{Read, Seek, SeekFrom};
+
+    let mut f = fs::File::open(input_file)?;
+    f.seek(SeekFrom::Start(start))?;
+
+    let n = usize::try_from(end - start)?;
+    let mut bytes = vec![0u8; n];
+    f.read_exact(&mut bytes)?;
+
+    String::from_utf8(bytes)
+        .map_err(|e| anyhow::anyhow!(
+            "invalid UTF-8 in input range {}..{}: {}",
+            start,
+            end,
+            e
+        ))
+}
