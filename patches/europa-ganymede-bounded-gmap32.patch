+////////////////////////////////////////////////////////////////////////////////
+// GANYMEDE: U32 GLOBAL MAP
+////////////////////////////////////////////////////////////////////////////////
+
+/// Build per-chunk local_id -> global_id maps as native u32le.
+///
+/// Output:
+///   `{gmap_dir}/chunk_{:03}.gmap32`
+///
+/// Local structural streams remain u16. Only the canonical global mapping
+/// widens when the merged vocabulary exceeds the u24 ID space.
+pub fn build_gmap32(
+    chunked_dict_dir: &str,
+    merged_dict_file: &str,
+    gmap_dir: &str,
+) -> Result<()> {
+    create_dir_all(gmap_dir)?;
+
+    // Ganymede: the historical load_merged_dict_map() is intentionally
+    // capped to the u24 namespace. For gmap32, load the canonical vocabulary
+    // without that u24 policy and move its Strings directly into a u32 map.
+    let global_toks = load_merged_dict_vec(merged_dict_file)?;
+
+    if global_toks.len() > u32::MAX as usize {
+        bail!(
+            "merged dict has {} tokens, exceeds supported u32 global space",
+            global_toks.len()
+        );
+    }
+
+    let global: std::collections::HashMap<String, u32> =
+        global_toks
+            .into_iter()
+            .enumerate()
+            .map(|(gid, tok)| (tok, gid as u32))
+            .collect();
+
+    redumb_log!(
+        "gmap32 canonical global vocabulary={}",
+        global.len()
+    );
+
+    let mut paths: Vec<PathBuf> = read_dir(chunked_dict_dir)?
+        .filter_map(|e| e.ok().map(|e| e.path()))
+        .filter(|path| {
+            path.file_name()
+                .and_then(|n| n.to_str())
+                .map(|fname| fname.starts_with("chunk_") && fname.ends_with(".dict"))
+                .unwrap_or(false)
+        })
+        .collect();
+
+    paths.sort();
+
+    for path in paths {
+        let fname = path
+            .file_name()
+            .and_then(|n| n.to_str())
+            .ok_or_else(|| anyhow::anyhow!("bad dict filename"))?;
+
+        let idx: usize =
+            fname["chunk_".len()..fname.len() - ".dict".len()].parse()?;
+
+        let content = fs::read_to_string(&path)?;
+
+        let out_path =
+            Path::new(gmap_dir).join(format!("chunk_{:03}.gmap32", idx));
+
+        let mut out =
+            BufWriter::with_capacity(WRITE_BUF_SIZE, File::create(&out_path)?);
+
+        let mut count = 0usize;
+
+        for tok in content.lines() {
+            let gid = global
+                .get(tok)
+                .copied()
+                .ok_or_else(|| anyhow::anyhow!(
+                    "token not found in merged dict: {:?}",
+                    tok
+                ))?;
+
+            let gid32 = u32::try_from(gid)
+                .map_err(|_| anyhow::anyhow!(
+                    "global id {} exceeds u32",
+                    gid
+                ))?;
+
+            out.write_all(&gid32.to_le_bytes())?;
+            count += 1;
+        }
+
+        out.flush()?;
+
+        redumb_log!(
+            "gmap32 chunk_{:03} local_vocab={} bytes={}",
+            idx,
+            count,
+            count * 4
+        );
+    }
+
+    Ok(())
+}
+
+fn load_gmap32(gmap_file: &Path) -> Result<Vec<u32>> {
+    let bytes = fs::read(gmap_file)?;
+
+    if bytes.len() % 4 != 0 {
+        bail!(
+            "gmap32 file {:?} length is not multiple of 4",
+            gmap_file
+        );
+    }
+
+    let mut map = Vec::with_capacity(bytes.len() / 4);
+
+    for quad in bytes.chunks_exact(4) {
+        map.push(u32::from_le_bytes([
+            quad[0],
+            quad[1],
+            quad[2],
+            quad[3],
+        ]));
+    }
+
+    Ok(map)
+}
+
+/// Restore local u16 streams through a u32 local-to-global map.
+pub fn restore_chunked_u16_gmap32(
+    merged_dict_file: &str,
+    gmap_dir: &str,
+    encoded_dir: &str,
+    output_file: &str,
+) -> Result<()> {
+    let global_toks = load_merged_dict_vec(merged_dict_file)?;
+    let chunks = collect_chunk_indices_by_ext(encoded_dir, "u16")?;
+
+    let mut out_w =
+        BufWriter::with_capacity(WRITE_BUF_SIZE, File::create(output_file)?);
+
+    for idx in chunks {
+        let gmap_path =
+            Path::new(gmap_dir).join(format!("chunk_{:03}.gmap32", idx));
+
+        let local_to_global = load_gmap32(&gmap_path)?;
+
+        let enc_path =
+            Path::new(encoded_dir).join(format!("chunk_{:03}.u16", idx));
+
+        let enc_bytes = fs::read(&enc_path)?;
+
+        if enc_bytes.len() % 2 != 0 {
+            bail!(
+                "u16 encoded file {:?} length is not multiple of 2",
+                enc_path
+            );
+        }
+
+        let mut chunk_buf = String::new();
+        let mut id_count = 0usize;
+
+        for pair in enc_bytes.chunks_exact(2) {
+            let local_id =
+                u16::from_le_bytes([pair[0], pair[1]]) as usize;
+
+            let global_id = *local_to_global
+                .get(local_id)
+                .ok_or_else(|| anyhow::anyhow!(
+                    "local id {} out of gmap32 range in chunk {}",
+                    local_id,
+                    idx
+                ))? as usize;
+
+            let tok = global_toks
+                .get(global_id)
+                .ok_or_else(|| anyhow::anyhow!(
+                    "global id {} out of merged dict range",
+                    global_id
+                ))?;
+
+            chunk_buf.push_str(tok);
+            id_count += 1;
+        }
+
+        write_restored_chunk_to_output(&mut out_w, &chunk_buf)?;
+
+        redumb_log!(
+            "restore chunk_{:03} u16+gmap32 ids={} local_vocab={} global_vocab={}",
+            idx,
+            id_count,
+            local_to_global.len(),
+            global_toks.len()
+        );
+    }
+
+    out_w.flush()?;
+    Ok(())
+}
